{
  "name": "@grials/testing-tools",
  "version": "1.0.0",
  "description": "Grials testing tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "husky-prepare": "husky install",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "build:ts": "rimraf dist/ && tsc",
    "build": "bash build.sh",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts}\"",
    "prepare": "npm run husky-prepare",
    "prepublishOnly": "npm run lint",
    "preversion": "npm run lint",
    "precommit": "lint-staged",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "nyc mocha --file ./tests/setup.ts tests/**/*.spec.ts",
    "test:only": "mocha --file ./tests/setup.ts tests/**/*.spec.ts",
    "test:basic": "ts-node ./tests/basic.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grials-enterprise/testing-tools.git"
  },
  "author": {
    "name": "grials.com"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/grials-enterprise/testing-tools/issues"
  },
  "homepage": "https://github.com/grials-enterprise/testing-tools#readme",
  "dependencies": {
    "kafkajs": "2.2.4",
    "mongoose": "8.18.0",
    "rxjs": "7.8.2",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/type-check": "^0.3.31",
    "@typescript-eslint/parser": "^8.70.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "mocha": "^12.0.0",
    "mongodb-memory-server": "11.2.0",
    "nock": "^14.0.17",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
